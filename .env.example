# Copy this file to .env and fill in at least one key.
# Naomi tries them in this order and uses the first one that works.

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Free: https://aistudio.google.com/apikey  (uses Gemini 3.6 Flash, then Gemma 4)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override models (comma-separated to try several)
# NAOMI_OPENAI_MODEL=gpt-5.4-mini
# NAOMI_DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
# NAOMI_GOOGLE_MODEL=gemini-3.6-flash,gemma-4-31b-it
