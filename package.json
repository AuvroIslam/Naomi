{
  "name": "naomi",
  "version": "0.1.0",
  "description": "Naomi — a patient, visual computer companion. Tell her what you want to do; she points the way.",
  "main": "src/main/main.js",
  "author": "Auvro Islam",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/start.js",
    "mock": "node scripts/start.js --mock",
    "check": "node scripts/check-api.js",
    "icon": "node -e \"delete process.env.ELECTRON_RUN_AS_NODE; require('child_process').spawnSync(require('electron'), ['scripts/make-icon.js'], {stdio: 'inherit'})\"",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win portable nsis"
  },
  "build": {
    "appId": "com.naomi.companion",
    "productName": "Naomi",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      ".env"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*"
    ],
    "win": {
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Naomi",
      "artifactName": "Naomi-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Naomi-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "dotenv": "^17.4.2",
    "openai": "^7.15.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  }
}
